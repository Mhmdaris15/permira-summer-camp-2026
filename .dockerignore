# Source-control / editor noise
.git
.gitignore
.gitattributes
.github
.vscode
.idea
*.swp
*.swo
.DS_Store

# Local installs / builds
node_modules
dist
server/dist
*.log

# Local env / secrets
.env
.env.*
!.env.example

# Local runtime state — must NOT bake into the image. Persistent volumes only.
# (Defaults for a fresh volume live in server/seed/, which IS shipped.)
server/data
server/uploads

# Test/probe artifacts
probe-*.mjs
coverage

# Raw art source — the full 169MB Medieval Village MegaKit lives here for
# future asset picks. Only the curated subset under public/kit/ ever ships.
# Never copy this into the image or let Vite see it.
art-source

# Docs
README.md
DEPLOYMENT.md
*.md
!server/README.md

# Docker artifacts
Dockerfile*
docker-compose*.yml
.dockerignore
