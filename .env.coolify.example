# =============================================================================
# Copy these into Coolify → Environment Variables for this resource.
# Mark GEMINI_API_KEY, ADMIN_TOKEN, JWT_SECRET as "Is Secret? ✓".
# =============================================================================

# --- Domains (Coolify also picks these up via SERVICE_FQDN_* in compose) ---
WEB_FQDN=https://summercamp2026.permiraspb.org
API_FQDN=https://api-summercamp2026.permiraspb.org

# --- Build-time: baked into the JS bundle ---
# MUST match API_FQDN. Changing it requires a rebuild of the web image.
VITE_API_URL=https://api-summercamp2026.permiraspb.org

# --- Backend secrets — fill in before deploy ---
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ADMIN_TOKEN=
JWT_SECRET=

# --- CORS — every origin the browser will use must be listed here ---
# Comma-separated. Add the web FQDN; add staging/preview hosts if any.
ALLOWED_ORIGINS=https://summercamp2026.permiraspb.org

# --- Optional overrides ---
LLM_MODEL=gemini-2.5-flash-lite
LOG_LEVEL=info
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_TIGHT=10
