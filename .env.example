# =============================================================================
# PERMIRA Summer Camp 2026 — Environment Variables
# Copy this file to .env (dev) or set in your hosting provider (prod).
# Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — required
# -----------------------------------------------------------------------------

# Google Gemini API key for the chatbot LLM. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret admins enter on /admin to log in. Treat as a password.
ADMIN_TOKEN=

# 32+ random chars used to sign admin JWTs. Rotating invalidates all sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# -----------------------------------------------------------------------------
# Backend — optional
# -----------------------------------------------------------------------------

# Gemini model id. Default: gemini-2.5-flash-lite
LLM_MODEL=gemini-2.5-flash-lite

# HTTP port the API listens on. Coolify sets this automatically.
PORT=8787

# Node environment. Set to "production" in deployed environments.
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for the API.
# Empty = allow all (fine for dev). Set explicitly in production.
# Example: ALLOWED_ORIGINS=https://camp.permiraspb.org,https://admin.permiraspb.org
ALLOWED_ORIGINS=

# Rate limits (requests per window).
RATE_LIMIT_GLOBAL=300   # per IP per 15 min, applies to all /api/*
RATE_LIMIT_TIGHT=10     # per IP per minute, applies to /api/auth and /api/chat

# -----------------------------------------------------------------------------
# Email (Resend) — powers admin notifications from the dashboard
# -----------------------------------------------------------------------------

# Resend API key. Get one at https://resend.com (verify the permiraspb.org
# domain so mail from info@permiraspb.org is accepted). If empty, sends fail
# cleanly and are recorded as "failed" in Email History.
RESEND_API_KEY=

# From header on every email. The domain must be verified in Resend.
EMAIL_FROM=PERMIRA Summer Camp 2026 <info@permiraspb.org>

# Set to 1/true to simulate sends locally (nothing is delivered; every send is
# logged as "dry-run"). Leave empty/unset in production.
EMAIL_DRY_RUN=

# -----------------------------------------------------------------------------
# File storage — Cloudflare R2 (S3-compatible). Required for uploads.
# Objects are private; the API serves short-lived presigned URLs.
# -----------------------------------------------------------------------------

# S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public custom domain bound to the bucket, used for browser-facing presigned
# URLs, e.g. storage.permiraspb.org. Leave empty to sign against R2_ENDPOINT.
R2_PUBLIC_HOST=storage.permiraspb.org

# -----------------------------------------------------------------------------
# Google Sheets mirror — one-way DB → Sheet backup + restore-from-Sheet.
# If unset, the mirror is a logged no-op. The target Sheet must be shared with
# the service account's client_email.
# -----------------------------------------------------------------------------

# Service-account key: paste the raw JSON, or base64-encode it (recommended to
# avoid newline/quote escaping in env editors).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet id (from the sheet URL: /spreadsheets/d/<THIS>/edit)
GOOGLE_SHEET_ID=
# Tab/worksheet name. Default: Participants
GOOGLE_SHEET_TAB=Participants

# -----------------------------------------------------------------------------
# Frontend — Vite, prefixed VITE_
# -----------------------------------------------------------------------------

# Public origin of the API. Empty in dev (Vite proxies /api → backend).
# Set in production to the deployed API URL, e.g. https://api.permiraspb.org
VITE_API_URL=
