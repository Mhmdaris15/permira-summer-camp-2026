# =============================================================================
# PERMIRA Summer Camp 2026 — Environment Variables
# Copy this file to .env (dev) or set in your hosting provider (prod).
# Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — required
# -----------------------------------------------------------------------------

# Google Gemini API key for the chatbot LLM. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret admins enter on /admin to log in. Treat as a password.
ADMIN_TOKEN=

# 32+ random chars used to sign admin JWTs. Rotating invalidates all sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# -----------------------------------------------------------------------------
# Backend — optional
# -----------------------------------------------------------------------------

# Gemini model id. Default: gemini-2.5-flash-lite
LLM_MODEL=gemini-2.5-flash-lite

# HTTP port the API listens on. Coolify sets this automatically.
PORT=8787

# Node environment. Set to "production" in deployed environments.
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for the API.
# Empty = allow all (fine for dev). Set explicitly in production.
# Example: ALLOWED_ORIGINS=https://camp.permira.id,https://admin.permira.id
ALLOWED_ORIGINS=

# Rate limits (requests per window).
RATE_LIMIT_GLOBAL=300   # per IP per 15 min, applies to all /api/*
RATE_LIMIT_TIGHT=10     # per IP per minute, applies to /api/auth and /api/chat

# -----------------------------------------------------------------------------
# Frontend — Vite, prefixed VITE_
# -----------------------------------------------------------------------------

# Public origin of the API. Empty in dev (Vite proxies /api → backend).
# Set in production to the deployed API URL, e.g. https://api.permira.id
VITE_API_URL=
