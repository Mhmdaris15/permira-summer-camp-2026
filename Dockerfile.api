# syntax=docker/dockerfile:1.7

# =============================================================================
# Backend image — Express + SurrealDB embedded.
# Multi-stage: build deps → compile TS → prod-only deps → slim runtime.
#
# Frontend libraries live in devDependencies, so the prod-deps stage
# (`--omit=dev`) installs ONLY the ~12 server runtime packages — the API
# image never ships React/Three/Vite.
# =============================================================================

# ---- Stage 1: full install (dev + prod) for the TS compile ----
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,id=npm-api,sharing=locked,target=/root/.npm \
    npm ci --legacy-peer-deps --include=dev --no-audit --no-fund

# ---- Stage 2: compile server TypeScript (copies only server sources) ----
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json ./
COPY server ./server
RUN npm run build:server

# ---- Stage 3: production-only deps (no devDependencies → no frontend tree) ----
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
# No `npm cache clean`: the cache lives in a discarded BuildKit mount (never
# in the image layer), so cleaning saves nothing and its destructive rmdir
# races concurrent writers on the shared cache → ENOTEMPTY. `sharing=locked`
# serializes this stage against the `deps` stage that uses the same cache id.
RUN --mount=type=cache,id=npm-api,sharing=locked,target=/root/.npm \
    npm ci --legacy-peer-deps --omit=dev --no-audit --no-fund

# ---- Stage 4: slim runtime ----
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8787

COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build     --chown=node:node /app/server/dist  ./server/dist
COPY --chown=node:node package.json ./

# Persistent dirs (mounted as volumes in compose).
RUN mkdir -p /app/server/data /app/server/uploads \
 && chown -R node:node /app/server

USER node
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT:-8787}/api/health || exit 1

# Exec form so SIGTERM reaches Node directly (graceful shutdown).
CMD ["node", "server/dist/index.js"]
