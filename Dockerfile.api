# syntax=docker/dockerfile:1.7

# =============================================================================
# Backend image — Express + SurrealDB embedded.
# Multi-stage: install → compile TS → ship only prod deps + dist.
# =============================================================================

# ---- Stage 1: install all deps ----
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps

# ---- Stage 2: compile TypeScript ----
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json ./
COPY server ./server
RUN npm run build:server

# ---- Stage 3: prod-only deps ----
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
# Production install — drops dev deps, keeps native bindings (@surrealdb/node).
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps --omit=dev

# ---- Stage 4: runtime ----
FROM node:22-alpine AS runtime
WORKDIR /app

# Run as a non-root user — `node` already exists in the base image (uid 1000).
ENV NODE_ENV=production
ENV PORT=8787

COPY --from=prod-deps  --chown=node:node /app/node_modules ./node_modules
COPY --from=build      --chown=node:node /app/server/dist  ./server/dist
COPY --chown=node:node package.json ./

# Create persistent dirs and hand them to the runtime user.
RUN mkdir -p /app/server/data /app/server/uploads \
 && chown -R node:node /app/server

USER node
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT:-8787}/api/health || exit 1

# Use exec form so SIGTERM reaches Node directly (graceful shutdown).
CMD ["node", "server/dist/index.js"]
