# syntax=docker/dockerfile:1.7

# =============================================================================
# Frontend image — Vite static build served by nginx.
# Multi-stage to keep the final image small (~50MB) and dependency-free.
# =============================================================================

# ---- Stage 1: install deps (with cache mount for speed) ----
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps

# ---- Stage 2: build the static bundle ----
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# VITE_API_URL is baked at build time — runtime env won't reach the browser.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build:web

# ---- Stage 3: serve with nginx ----
FROM nginx:1.27-alpine AS runtime

# API origin used by the CSP `connect-src` directive in nginx.conf.
# Defaults to VITE_API_URL so they stay in sync, but can be overridden.
ARG VITE_API_URL=""
ARG API_ORIGIN=""

# Drop default config, write ours with the API origin substituted in.
RUN rm /etc/nginx/conf.d/default.conf
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf.template
RUN ORIGIN="${API_ORIGIN:-${VITE_API_URL}}"; \
    if [ -z "$ORIGIN" ]; then ORIGIN="'self'"; fi; \
    sed "s|__API_ORIGIN__|$ORIGIN|g" /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && \
    rm /etc/nginx/conf.d/default.conf.template && \
    nginx -t

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8081/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
