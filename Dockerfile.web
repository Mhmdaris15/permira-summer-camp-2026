# syntax=docker/dockerfile:1.7

# =============================================================================
# Frontend image — Vite static build served by nginx.
# Multi-stage; the final image is just nginx + static dist/ (~50MB, no node).
# =============================================================================

# ---- Stage 1: install deps (cache-mounted; layer reused unless lockfile changes) ----
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# --include=dev: Vite needs the frontend libs (which live in devDependencies)
# --no-audit --no-fund: skip slow registry round-trips during CI/Coolify builds
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps --include=dev --no-audit --no-fund

# ---- Stage 2: build the static bundle ----
FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# Copy ONLY frontend build inputs (not server/) so a backend-only change
# never invalidates this layer's cache.
COPY package.json package-lock.json ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html ./
COPY src ./src
COPY public ./public

# VITE_API_URL is baked at build time — runtime env won't reach the browser.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build:web

# ---- Stage 3: serve with nginx ----
FROM nginx:1.27-alpine AS runtime

# API origin used by the CSP `connect-src` directive in nginx.conf.
ARG VITE_API_URL=""
ARG API_ORIGIN=""

# Drop default config, write ours with the API origin substituted in.
RUN rm /etc/nginx/conf.d/default.conf
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf.template
RUN ORIGIN="${API_ORIGIN:-${VITE_API_URL}}"; \
    if [ -z "$ORIGIN" ]; then ORIGIN="'self'"; fi; \
    sed "s|__API_ORIGIN__|$ORIGIN|g" /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && \
    rm /etc/nginx/conf.d/default.conf.template && \
    nginx -t

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
